# Database
DATABASE_URL="postgresql://myepibooking:myepibooking_dev_2025@localhost:5432/myepibooking?schema=public"

# Server
PORT=3001
NODE_ENV=development

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
